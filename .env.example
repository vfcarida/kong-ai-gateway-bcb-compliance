# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Kong AI Gateway — Environment Configuration                               ║
# ║  Compliance Framework: BCB CMN 4893/21 & BCB 85/21                           ║
# ║  Copy to .env and configure environment variables.                         ║
# ║  >> cp .env.example .env                                                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Deployment Profile & Licensing ───────────────────────────────────────────
# COMPOSE PROFILES:
# • OSS profile (default recommended for local/evaluation):
#   docker compose --profile oss up
#   Runs 100% license-free Community Edition (kong:3.14).
#   KONG_LICENSE_DATA is NOT required. Redis is NOT required.
#
# • Enterprise profile (full FinOps & Token rate-limiting suite):
#   docker compose --profile enterprise up
#   Requires valid KONG_LICENSE_DATA below + OPENAI_API_KEY for vector embeddings.
KONG_LICENSE_DATA=

# ── AWS Bedrock Credentials ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=sa-east-1

# ── OpenAI & Azure OpenAI Credentials ────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ── AI Model Provider Settings ──────────────────────────────────────────────
# For local offline sandbox testing:
AI_PROVIDER=openai
AI_MODEL_NAME=mock-compliance-llm
AI_UPSTREAM_URL=https://pii-sanitizer:8443/mock-llm

# For production AWS Bedrock:
# AI_PROVIDER=bedrock
# AI_MODEL_NAME=amazon.titan-text-express-v1

# ── PII Sanitizer Engine ────────────────────────────────────────────────────
# Options: 'placeholder' ([REDACTED_CPF_1]) or 'synthetic' (valid fake CPF/CNPJ)
PII_REDACT_TYPE=placeholder

# ── Redis Vector Search Backend ─────────────────────────────────────────────
REDIS_HOST=redis-vector
REDIS_PORT=6379
